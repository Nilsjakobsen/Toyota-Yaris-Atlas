{
  "name": "toyota-yaris-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D guide to one specific Toyota Yaris: components, locations, symptoms and an owner's log.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node tools/check-privacy.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:privacy": "node tools/check-privacy.mjs",
    "gen:ids": "node tools/gen-component-ids.mjs",
    "audit": "node tools/audit.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run audit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
